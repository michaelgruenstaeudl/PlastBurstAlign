    title: "Benchmarking data sets for software 'plastburstalign'"
    doi: "10.5281/zenodo.17137737"
    url: "https://zenodo.org/records/17137737"
    authors:
      - family-names: Gruenstaeudl
        given-names: Michael
    # The datasets are described in benchmarking/plastbench/datasets.json.
